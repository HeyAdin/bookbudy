# Application
PROJECT_NAME="Book Buddy API"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration (SQLAlchemy 2.x with psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/book_buddy

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
